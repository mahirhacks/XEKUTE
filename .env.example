# Optional environment overrides for XEKUTE development.
# Copy to .env and fill in values as needed. Never commit .env files.

# Local Ollama API (default: http://127.0.0.1:11434)
# OLLAMA_HOST=http://127.0.0.1:11434

# OpenRouter API key (alternative to Settings > LLM secure storage)
# OPENROUTER_API_KEY=

# OpenRouter API base URL (default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional shell and Python overrides for terminal and automation commands
# POINTER_SHELL=
# POINTER_PYTHON=

# Node environment (development enables extra diagnostics)
# NODE_ENV=development
