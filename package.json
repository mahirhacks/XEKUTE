{
  "name": "xekute-app",
  "version": "0.1.0",
  "productName": "XEKUTE",
  "description": "XEKUTE - local-first penetration testing and vulnerability assessment workspace",
  "main": "src/presentation/electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electronmon --inspect=5858 . --dev",
    "test": "node --test",
    "build:prompts": "node src/content/prompt_builder.js",
    "verify:production": "node scripts/verify-production.js",
    "verify:unified-harness": "node scripts/verify-unified-harness.js",
    "package": "electron-forge package",
    "make": "electron-forge make --platform=win32 --arch=x64",
    "release:metadata": "node scripts/release-metadata.js",
    "verify:native": "node -e \"require('node-pty'); console.log('node-pty prebuild available')\"",
    "audit:runtime": "npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@electron/rebuild": "4.1.0",
    "electron": "43.1.0",
    "electronmon": "2.0.4"
  },
  "electronmon": {
    "patterns": [
      "!test/**",
      "!graphify-out/**",
      "!version_tracking/**"
    ]
  },
  "dependencies": {
    "@vscode/codicons": "0.0.45",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "http-mitm-proxy": "^1.1.0",
    "marked": "^18.0.5",
    "mermaid": "^11.16.0",
    "monaco-editor": "0.52.2",
    "node-pty": "^1.1.0",
    "tldts": "^7.4.8"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
